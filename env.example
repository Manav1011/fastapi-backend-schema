ENV=local
DEBUG=true

SECRET_KEY=change-me

# Single database (backward compatibility)
DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3

# Multiple databases (Django-like)
# Format: DATABASES=alias1:url1,alias2:url2
# Examples:
# DATABASES=default:sqlite+aiosqlite:///./db.sqlite3,analytics:postgresql+asyncpg://user:pass@localhost/analytics
# DATABASES=default:postgresql+asyncpg://user:pass@localhost/mydb,readonly:postgresql+asyncpg://readonly:pass@localhost/mydb

# Comma-separated list
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Comma-separated list
TRUSTED_HOSTS=localhost,127.0.0.1

ADMIN_PATH=/admin

JWT_SECRET=change-me-too
JWT_LIFETIME_SECONDS=3600


